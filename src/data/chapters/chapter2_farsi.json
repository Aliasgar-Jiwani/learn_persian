  "lesson_id": "lesson_2",
  "chapter": 2,
  "title": "درس دوم",
  "title_transliteration": "dars-e dovvom",
  "title_english": "Lesson Two",
  "patterns": [
    {
      "id": "pattern_1",
      "label": "Pattern 1 — X روی Y است (X is on Y)",
      "farsi": "[noun] روی [place] است.",
      "transliteration": "[noun] roo-ye [place] ast",
      "english": "___ is on the ___.",
      "grammar_note": "روی (roo-ye) = on top of. The ezafe -e links the preposition to the following noun: روی میز = on the table.",
      "examples": [
        {
          "farsi": "کتاب روی میز است.",
          "transliteration": "ketab roo-ye miz ast",
          "english": "The book is on the table.",
          "id": "pattern_1_ex_1",
          "audio": null
        },
        {
          "farsi": "مداد روی دفتر است.",
          "transliteration": "medad roo-ye daftar ast",
          "english": "The pencil is on the notebook.",
          "id": "pattern_1_ex_2",
          "audio": null
        },
        {
          "farsi": "کیف روی میز است.",
          "transliteration": "kif roo-ye miz ast",
          "english": "The bag is on the table.",
          "id": "pattern_1_ex_3",
          "audio": null
        },
        {
          "farsi": "کیف کوچک روی میز است.",
          "transliteration": "kif-e kuchak roo-ye miz ast",
          "english": "The small bag is on the table.",
          "id": "pattern_1_ex_4",
          "audio": null
        }
      ],
      "difficulty": "easy"
    },
    {
      "id": "pattern_2",
      "label": "Pattern 2 — X زیر Y است (X is under Y)",
      "farsi": "[noun] زیر [place] است.",
      "transliteration": "[noun] zir-e [place] ast",
      "english": "___ is under the ___.",
      "grammar_note": "زیر (zir) = under/below. Same ezafe construction as روی.",
      "examples": [
        {
          "farsi": "دفتر زیر میز است.",
          "transliteration": "daftar zir-e miz ast",
          "english": "The notebook is under the table.",
          "id": "pattern_2_ex_1",
          "audio": null
        },
        {
          "farsi": "قلم زیر کتاب است.",
          "transliteration": "qalam zir-e ketab ast",
          "english": "The pen is under the book.",
          "id": "pattern_2_ex_2",
          "audio": null
        },
        {
          "farsi": "دختر کوچک زیر میز است.",
          "transliteration": "dokhtar-e kuchak zir-e miz ast",
          "english": "The little girl is under the table.",
          "id": "pattern_2_ex_3",
          "audio": null
        },
        {
          "farsi": "مداد کوچک تو زیر کتاب است.",
          "transliteration": "medad-e kuchak-e to zir-e ketab ast",
          "english": "Your small pencil is under the book.",
          "id": "pattern_2_ex_4",
          "audio": null
        }
      ],
      "difficulty": "easy"
    },
    {
      "id": "pattern_3",
      "label": "Pattern 3 — Ezafe: Noun + Adjective",
      "farsi": "[noun]-ِ [adjective]",
      "transliteration": "[noun]-e [adjective]",
      "english": "___ (adjective) ___ (noun) — adjective follows the noun, linked by ezafe -e",
      "grammar_note": "The ezafe (-e or -ye) is a short unstressed vowel suffix that links a noun to its modifier. It is not written in standard script but is pronounced. Example: کتاب بزرگ [ketab-e bozorg] = big book.",
      "examples": [
        {
          "farsi": "کتاب کوچک زیر میز است.",
          "transliteration": "ketab-e kuchak zir-e miz ast",
          "english": "The small book is under the table.",
          "id": "pattern_3_ex_1",
          "audio": null
        },
        {
          "farsi": "کتاب بزرگ روی میز است.",
          "transliteration": "ketab-e bozorg roo-ye miz ast",
          "english": "The big book is on the table.",
          "id": "pattern_3_ex_2",
          "audio": null
        },
        {
          "farsi": "قلم کوتاه زیر کتاب است.",
          "transliteration": "qalam-e kutah zir-e ketab ast",
          "english": "The short pen is under the book.",
          "id": "pattern_3_ex_3",
          "audio": null
        },
        {
          "farsi": "مداد بلند روی دفتر است.",
          "transliteration": "medad-e boland roo-ye daftar ast",
          "english": "The long pencil is on the notebook.",
          "id": "pattern_3_ex_4",
          "audio": null
        },
        {
          "farsi": "دفتر بزرگ در کیف است.",
          "transliteration": "daftar-e bozorg dar kif ast",
          "english": "The big notebook is in the bag.",
          "id": "pattern_3_ex_5",
          "audio": null
        },
        {
          "farsi": "کیف قدیمی روی میز است.",
          "transliteration": "kif-e qadimi roo-ye miz ast",
          "english": "The old bag is on the table.",
          "id": "pattern_3_ex_6",
          "audio": null
        }
      ],
      "difficulty": "easy"
    },
    {
      "id": "pattern_4",
      "label": "Pattern 4 — X در Y است (X is in/at Y)",
      "farsi": "[noun] در [place] است.",
      "transliteration": "[noun] dar [place] ast",
      "english": "___ is in/at the ___.",
      "grammar_note": "در (dar) as a preposition means 'in' or 'at'. It is written and pronounced the same as در (dar) meaning 'door' from lesson 1. Context alone distinguishes the two: در کلاس = in the classroom (preposition); این در است = this is a door (noun).",
      "examples": [
        {
          "farsi": "پسر در مدرسه است.",
          "transliteration": "pesar dar madrese ast",
          "english": "The boy is at school.",
          "id": "pattern_4_ex_1",
          "audio": null
        },
        {
          "farsi": "دختر در کلاس است.",
          "transliteration": "dokhtar dar kelas ast",
          "english": "The girl is in the classroom.",
          "id": "pattern_4_ex_2",
          "audio": null
        },
        {
          "farsi": "کیف در کلاس است.",
          "transliteration": "kif dar kelas ast",
          "english": "The bag is in the classroom.",
          "id": "pattern_4_ex_3",
          "audio": null
        },
        {
          "farsi": "مداد در کیف است.",
          "transliteration": "medad dar kif ast",
          "english": "The pencil is in the bag.",
          "id": "pattern_4_ex_4",
          "audio": null
        },
        {
          "farsi": "دختر کوچک در اتاق است.",
          "transliteration": "dokhtar-e kuchak dar otaq ast",
          "english": "The little girl is in the room.",
          "id": "pattern_4_ex_5",
          "audio": null
        },
        {
          "farsi": "پسر کوچک در خانه است.",
          "transliteration": "pesar-e kuchak dar khane ast",
          "english": "The little boy is at home.",
          "id": "pattern_4_ex_6",
          "audio": null
        },
        {
          "farsi": "زن جوان در خانه است.",
          "transliteration": "zan-e javan dar khane ast",
          "english": "The young woman is at home.",
          "id": "pattern_4_ex_7",
          "audio": null
        },
        {
          "farsi": "مرد پیر در اتاق است.",
          "transliteration": "mard-e pir dar otaq ast",
          "english": "The old man is in the room.",
          "id": "pattern_4_ex_8",
          "audio": null
        }
      ],
      "difficulty": "easy"
    },
    {
      "id": "pattern_5",
      "label": "Pattern 5 — Possession: این [noun] [pronoun] است",
      "farsi": "این [noun] [pronoun] است.",
      "transliteration": "in [noun]-e [pronoun] ast",
      "english": "This ___ is mine/yours/his…",
      "grammar_note": "To express possession, the possessive pronoun follows the noun directly, linked by ezafe. Example: این کتاب من است [in ketab-e man ast] = This book is mine.",
      "pronouns_table": [
        {
          "farsi": "من",
          "transliteration": "man",
          "english": "I / me / my"
        },
        {
          "farsi": "تو",
          "transliteration": "to",
          "english": "you / your (informal)"
        },
        {
          "farsi": "او",
          "transliteration": "u",
          "english": "he/she / him/her / his or her"
        },
        {
          "farsi": "ما",
          "transliteration": "ma",
          "english": "we / us / our"
        },
        {
          "farsi": "شما",
          "transliteration": "shoma",
          "english": "you / your (formal or plural)"
        },
        {
          "farsi": "آنها",
          "transliteration": "anha",
          "english": "they / them / their"
        }
      ],
      "examples": [
        {
          "farsi": "این کتاب من است.",
          "transliteration": "in ketab-e man ast",
          "english": "This book is mine.",
          "id": "pattern_5_ex_1",
          "audio": null
        },
        {
          "farsi": "این کتاب تو است.",
          "transliteration": "in ketab-e to ast",
          "english": "This book is yours.",
          "id": "pattern_5_ex_2",
          "audio": null
        },
        {
          "farsi": "این کتاب او است.",
          "transliteration": "in ketab-e u ast",
          "english": "This book is his or hers.",
          "id": "pattern_5_ex_3",
          "audio": null
        },
        {
          "farsi": "این کتاب ما است.",
          "transliteration": "in ketab-e ma ast",
          "english": "This book is ours.",
          "id": "pattern_5_ex_4",
          "audio": null
        },
        {
          "farsi": "این کتاب شما است.",
          "transliteration": "in ketab-e shoma ast",
          "english": "This book is yours (formal/plural).",
          "id": "pattern_5_ex_5",
          "audio": null
        },
        {
          "farsi": "این کتاب آنها است.",
          "transliteration": "in ketab-e anha ast",
          "english": "This book is theirs.",
          "id": "pattern_5_ex_6",
          "audio": null
        }
      ],
      "difficulty": "easy"
    },
    {
      "id": "pattern_6",
      "label": "Pattern 6 — Full Noun Phrase: Noun + Adjective + Pronoun",
      "farsi": "این [noun]-ِ [adjective]-ِ [pronoun] است.",
      "transliteration": "in [noun]-e [adj]-e [pronoun] ast",
      "english": "This [adj] [noun] is mine/yours/his…",
      "grammar_note": "Multiple ezafe links chain noun → adjective → possessive into a single noun phrase. Each link uses the same -e connector.",
      "examples": [
        {
          "farsi": "این کتاب بزرگ من است.",
          "transliteration": "in ketab-e bozorg-e man ast",
          "english": "This big book is mine.",
          "id": "pattern_6_ex_1",
          "audio": null
        },
        {
          "farsi": "کتاب بزرگ من روی میز است.",
          "transliteration": "ketab-e bozorg-e man roo-ye miz ast",
          "english": "My big book is on the table.",
          "id": "pattern_6_ex_2",
          "audio": null
        },
        {
          "farsi": "این دفتر بزرگ او است.",
          "transliteration": "in daftar-e bozorg-e u ast",
          "english": "This big notebook is his or hers.",
          "id": "pattern_6_ex_3",
          "audio": null
        },
        {
          "farsi": "دفتر بزرگ او در کیف است.",
          "transliteration": "daftar-e bozorg-e u dar kif ast",
          "english": "His or her big notebook is in the bag.",
          "id": "pattern_6_ex_4",
          "audio": null
        },
        {
          "farsi": "این مداد کوچک تو است.",
          "transliteration": "in medad-e kuchak-e to ast",
          "english": "This small pencil is yours.",
          "id": "pattern_6_ex_5",
          "audio": null
        },
        {
          "farsi": "مداد کوچک تو زیر کتاب است.",
          "transliteration": "medad-e kuchak-e to zir-e ketab ast",
          "english": "Your small pencil is under the book.",
          "id": "pattern_6_ex_6",
          "audio": null
        },
        {
          "farsi": "استاد جوان ما در کلاس است.",
          "transliteration": "ostad-e javan-e ma dar kelas ast",
          "english": "Our young professor is in the classroom.",
          "id": "pattern_6_ex_7",
          "audio": null
        }
      ],
      "difficulty": "medium"
    }
  ],
