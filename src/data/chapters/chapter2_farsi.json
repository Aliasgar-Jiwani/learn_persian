          "id": "text_1_sent_18",
          "audio": null
        },
        {
          "farsi": "این آموزگار ژاله است.",
          "transliteration": "in amuzegar-e zhale ast",
          "english": "This is Zhale's teacher.",
          "id": "text_1_sent_19",
          "audio": null
        },
        {
          "farsi": "اسم آموزگار ژاله خانم امینی است.",
          "transliteration": "esm-e amuzegar-e zhale khanom-e amini ast",
          "english": "The name of Zhale's teacher is Mrs. Amini.",
          "id": "text_1_sent_20",
          "audio": null
        },
        {
          "farsi": "خانم امینی، آموزگار ژاله است.",
          "transliteration": "khanom-e amini, amuzegar-e zhale ast",
          "english": "Mrs. Amini is Zhale's teacher.",
          "id": "text_1_sent_21",
          "audio": null
        },
        {
          "farsi": "این دختر، دوست ژاله است.",
          "transliteration": "in dokhtar, dust-e zhale ast",
          "english": "This girl is Zhale's friend.",
          "id": "text_1_sent_22",
          "audio": null
        },
        {
          "farsi": "اسم دوست ژاله، سارا است.",
          "transliteration": "esm-e dust-e zhale, sara ast",
