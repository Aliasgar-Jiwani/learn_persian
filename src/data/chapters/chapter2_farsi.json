  "reading_texts": [
    {
      "id": "text_1",
      "title": "متن — خانواده پرویز",
      "title_english": "Reading Text — Parviz's Family",
      "sentences": [
        {
          "farsi": "این مرد، پرویز است.",
          "transliteration": "in mard, parviz ast",
          "english": "This man is Parviz.",
          "id": "text_1_sent_1",
          "audio": null
        },
        {
          "farsi": "پرویز پدر کاوه و ژاله است.",
          "transliteration": "parviz pedar-e kaveh va zhale ast",
          "english": "Parviz is the father of Kaveh and Zhale.",
          "id": "text_1_sent_2",
          "audio": null
        },
        {
          "farsi": "کاوه پسر پرویز است.",
          "transliteration": "kaveh pesar-e parviz ast",
          "english": "Kaveh is Parviz's son.",
          "id": "text_1_sent_3",
          "audio": null
        },
        {
          "farsi": "ژاله دختر پرویز است.",
          "transliteration": "zhale dokhtar-e parviz ast",
          "english": "Zhale is Parviz's daughter.",
          "id": "text_1_sent_4",
          "audio": null
        },
        {
          "farsi": "اسم مادر کاوه و ژاله، پروین است.",
          "transliteration": "esm-e madar-e kaveh va zhale, parvin ast",
          "english": "The name of Kaveh and Zhale's mother is Parvin.",
          "id": "text_1_sent_5",
          "audio": null
        },
        {
          "farsi": "پروین خانه‌دار است.",
          "transliteration": "parvin khanedar ast",
          "english": "Parvin is a homemaker.",
          "id": "text_1_sent_6",
          "audio": null
        },
        {
          "farsi": "پروین همسر پرویز است.",
          "transliteration": "parvin hamsar-e parviz ast",
          "english": "Parvin is Parviz's wife.",
          "id": "text_1_sent_7",
          "audio": null
        },
        {
          "farsi": "کاوه دانش‌آموز است.",
          "transliteration": "kaveh danesh-amuz ast",
          "english": "Kaveh is a student.",
          "id": "text_1_sent_8",
          "audio": null
        },
        {
          "farsi": "او دانش‌آموز دبیرستان است.",
          "transliteration": "u danesh-amuz-e dabirestan ast",
          "english": "He is a high school student.",
          "id": "text_1_sent_9",
          "audio": null
        },
        {
          "farsi": "اینجا کلاس کاوه است.",
          "transliteration": "inja kelas-e kaveh ast",
          "english": "This is Kaveh's classroom.",
          "id": "text_1_sent_10",
          "audio": null
        },
        {
          "farsi": "این دبیر کاوه است.",
          "transliteration": "in dabir-e kaveh ast",
          "english": "This is Kaveh's teacher.",
          "id": "text_1_sent_11",
          "audio": null
        },
        {
          "farsi": "اسم دبیر کاوه، آقای مجیدی است.",
          "transliteration": "esm-e dabir-e kaveh, aqa-ye majidi ast",
          "english": "The name of Kaveh's teacher is Mr. Majidi.",
          "id": "text_1_sent_12",
          "audio": null
        },
        {
          "farsi": "آقای مجیدی دبیر فیزیک است.",
          "transliteration": "aqa-ye majidi dabir-e fizik ast",
          "english": "Mr. Majidi is a physics teacher.",
          "id": "text_1_sent_13",
          "audio": null
        },
        {
          "farsi": "این پسر دوست کاوه است.",
          "transliteration": "in pesar dust-e kaveh ast",
          "english": "This boy is Kaveh's friend.",
          "id": "text_1_sent_14",
          "audio": null
        },
        {
          "farsi": "اسم دوست کاوه دارا است.",
          "transliteration": "esm-e dust-e kaveh dara ast",
          "english": "The name of Kaveh's friend is Dara.",
          "id": "text_1_sent_15",
          "audio": null
        },
        {
          "farsi": "ژاله دانش‌آموز است.",
          "transliteration": "zhale danesh-amuz ast",
          "english": "Zhale is a student.",
          "id": "text_1_sent_16",
          "audio": null
        },
        {
          "farsi": "او دانش‌آموز دبستان است.",
          "transliteration": "u danesh-amuz-e dabestan ast",
          "english": "She is a primary school student.",
          "id": "text_1_sent_17",
